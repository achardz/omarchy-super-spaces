{
  "schemaVersion": 1,
  "id": "anz.super-spaces",
  "name": "Super Spaces",
  "version": "1.2.0",
  "author": "anz",
  "license": "MIT",
  "description": "Workspace bar where workspaces past 9 fold behind +/-, plus a lightweight search for windows, apps, files and quick maths that runs inside the Omarchy shell",
  "kinds": [
    "bar-widget",
    "menu"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "Workspaces.qml",
    "menu": "Launcher.qml"
  },
  "barWidget": {
    "displayName": "Super Spaces",
    "description": "Workspaces 1-9, with 10+ folded behind +/-",
    "category": "Compositor",
    "allowMultiple": false
  },
  "omarchy": {
    "clonedFrom": "omarchy.workspaces"
  }
}
