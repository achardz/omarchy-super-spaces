#!/bin/bash
# Lists AI agent sessions logged on this machine for Super Spaces search, one
# per line, newest first:  agent<TAB>id<TAB>title<TAB>cwd<TAB>epoch-seconds
# Reads only the first few KB of each log. Supported: omp (oh-my-pi); Claude
# Code and Codex CLI are read when their log folders exist.
set -uo pipefail

clean() { tr '\t\n\r' '   ' | cut -c1-140; }

{
  # omp: ~/.omp/agent/sessions/<dir>/<time>_<id>.jsonl; first lines carry
  # {"type":"title"} and {"type":"session","id","cwd"}. Subagent logs live in
  # per-session subfolders and are skipped.
  for f in "$HOME"/.omp/agent/sessions/*/*.jsonl; do
    [[ -f $f ]] || continue
    head -n 4 "$f" | jq -Rrs --arg m "$(stat -c %Y "$f")" '
      [split("\n")[] | fromjson? ] |
      (map(select(.type=="title"))[0].title // "") as $t
      | (map(select(.type=="session"))[0] // {}) as $s
      | select($s.id) | ["omp", $s.id, ($t // ""), ($s.cwd // ""), $m] | @tsv' 2>/dev/null
  done

  # Claude Code: ~/.claude/projects/<project>/<session-id>.jsonl
  for f in "$HOME"/.claude/projects/*/*.jsonl; do
    [[ -f $f ]] || continue
    id=$(basename "$f" .jsonl)
    head -n 30 "$f" | jq -Rrs --arg id "$id" --arg m "$(stat -c %Y "$f")" '
      [split("\n")[] | fromjson? ] |
      (map(select(.type=="summary"))[0].summary
        // (map(select(.type=="user"))[0].message.content | if type=="string" then . else (.[0].text // "") end)
        // "") as $t
      | (map(select(.cwd))[0].cwd // "") as $c
      | ["claude", $id, $t, $c, $m] | @tsv' 2>/dev/null
  done

  # Codex CLI: ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl with session_meta.
  while IFS= read -r f; do
    head -n 30 "$f" | jq -Rrs --arg m "$(stat -c %Y "$f")" '
      [split("\n")[] | fromjson? ] |
      (map(select(.type=="session_meta"))[0].payload // {}) as $p
      | select($p.id)
      | (map(select(.type=="response_item" and .payload.role=="user"))[0].payload.content[0].text // "") as $t
      | ["codex", $p.id, $t, ($p.cwd // ""), $m] | @tsv' 2>/dev/null
  done < <(find "$HOME/.codex/sessions" -name 'rollout-*.jsonl' 2>/dev/null)
} | awk -F'\t' 'BEGIN{OFS="\t"} { gsub(/[\r\n]/," ",$3); $3=substr($3,1,140); print }' | sort -t$'\t' -k5,5nr
