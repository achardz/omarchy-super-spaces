#!/bin/bash
# Pick a workspace from the list of existing ones (with their apps), or choose
# "Other number…" to type any 1-99; with --move, take the active window along.
# Part of Super Spaces (anz.super-spaces); see README for the Super + N setup.
set -euo pipefail

label="Go to workspace"
[[ ${1:-} == --move ]] && label="Move window to workspace"
other="Other number…"

current=$(hyprctl activeworkspace -j | jq '.id')

# One row per workspace: "<icon><TAB><id><TAB><what's on it>". omarchy-menu-select
# shows the icon but drops it from what it returns, so the pick comes back as
# "<id><TAB>...". The current workspace gets a filled dot.
#
# The subtext lists each window as "<app>: <title>" and the menu filters on it,
# so typing "youtube", a file name or a site finds the workspace showing it.
# Tabs/newlines in titles would break the row format, so they become spaces.
mapfile -t rows < <(
  hyprctl clients -j | jq -r --argjson cur "$current" --slurpfile ws <(hyprctl workspaces -j) '
    def clean: gsub("[\t\n\r]+"; " ") | gsub("^ +| +$"; "");
    # Web apps ("chrome-x.com__-Default") keep their site; others their last segment.
    def short: if startswith("chrome-") then sub("^chrome-"; "") | sub("__.*$"; "") else split(".") | last end | clean;
    def cut(n): if length > n then .[0:n] + "…" else . end;
    . as $clients
    | $ws[0] | map(select(.id > 0)) | sort_by(.id)[]
    | .id as $id
    | ([$clients[] | select(.workspace.id == $id)
        | (.class | short) as $app | (.title | clean | cut(60)) as $t
        | if $t == "" or ($t | ascii_downcase) == ($app | ascii_downcase) then $app else "\($app): \($t)" end]
       | join("  ·  ")) as $wins
    | "\(if $id == $cur then "●" else "○" end)\t\($id)\t\(if $wins == "" then "empty" else $wins end)"'
)

choice=$(omarchy-menu-select "$label" "${rows[@]}" "$other" -- --width 420) || exit 0

if [[ $choice == "$other" ]]; then
  n=$(omarchy-menu-input "$label" --width 300) || exit 0
else
  n=${choice%%$'\t'*}
fi
n=${n//[[:space:]]/}

if [[ ! $n =~ ^[1-9][0-9]?$ ]]; then
  notify-send "Workspace" "Type a number from 1 to 99 (got: ${n:-nothing})"
  exit 1
fi

if [[ ${1:-} == --move ]]; then
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$n\" })" >/dev/null
else
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$n\" })" >/dev/null
fi
