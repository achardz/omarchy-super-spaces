// Super Spaces settings page for the Omarchy menu (Setup › Super Spaces).
// Paste these entries inside the { } of ~/.config/omarchy/extensions/omarchy-menu.jsonc.
  "setup.super-spaces": {"icon":"󱂬","label":"Super Spaces","aliases":["super-spaces"],"description":"Super Spaces plugin settings and shortcuts"},
  "setup.super-spaces.search": {"icon":"󰀻","label":"Open Search","description":"Super Spaces search: windows, apps, files, maths, keys, menu","action":"omarchy-shell shell toggle anz.super-spaces '{}'"},
  "setup.super-spaces.goto": {"icon":"󱂬","label":"Go to Workspace…","description":"Pick a workspace by number or by what is open on it","when":"[[ -x ~/.local/bin/workspace-goto ]]","action":"$HOME/.local/bin/workspace-goto"},
  "setup.super-spaces.keybindings": {"icon":"","label":"Keybindings","description":"Change the Super Spaces keys (SUPER + SPACE and SUPER + N) in bindings.lua","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.super-spaces.edit": {"icon":"","label":"Edit Search","description":"Open the search code (Launcher.qml) in the editor","action":"omarchy-launch-config-editor \"$HOME/.config/omarchy/plugins/anz.super-spaces/Launcher.qml\""},
  "setup.super-spaces.folder": {"icon":"","label":"Plugin Folder","description":"Open the plugin folder in the file manager","action":"xdg-open \"$HOME/.config/omarchy/plugins/anz.super-spaces\""},
  "setup.super-spaces.reset-ranking": {"icon":"󰑓","label":"Reset App Ranking","description":"Forget launch counts used to rank apps","when":"[[ -f ~/.local/state/anz.super-spaces/app-usage.json ]]","action":"rm -f \"$HOME/.local/state/anz.super-spaces/app-usage.json\" && notify-send 'Super Spaces' 'App ranking reset'"},
  "setup.super-spaces.restart": {"icon":"󰍜","label":"Restart Shell","description":"Reload Super Spaces after editing its files","action":"omarchy restart shell"},
  "setup.super-spaces.update": {"icon":"","label":"Update Plugin","description":"Pull the latest Super Spaces from GitHub (shows the changes first)","action":"omarchy-launch-floating-terminal-with-presentation omarchy plugin update anz.super-spaces"},
